 "html": "<style>\n@media print { @page { size: 72mm auto; margin: 0; } body { margin: 0; } }\n.mr { width: 72mm; box-sizing: border-box; padding: 3mm 3mm; font-family: Arial, Helvetica, sans-serif; color: #000; text-align: center; }\n.mr .hdr { font-size: 15px; font-weight: 800; letter-spacing: 1px; }\n.mr .sub { font-size: 10px; margin-bottom: 4px; }\n.mr .meal { font-size: 20px; font-weight: 800; margin: 6px 0; }\n.mr table { margin: 6px auto; border-collapse: collapse; font-size: 12px; }\n.mr td { padding: 2px 8px; vertical-align: top; }\n.mr td.k { text-align: left; color: #333; }\n.mr td.v { text-align: left; font-weight: 700; word-break: break-word; }\n.mr .foot { font-size: 9px; color: #333; margin-top: 6px; word-break: break-all; }\n.mr hr { border: none; border-top: 1px dashed #000; margin: 5px 0; }\n.mr img { display: block; margin: 8px auto 0; }\n</style>\n{%- set emp = frappe.db.get_value(\"Employee\", doc.employee, \"employee_name\") or doc.employee or \"-\" -%}\n{%- set payroll = doc.payroll_number or doc.employee or \"-\" -%}\n{%- set tqr = (doc.time or \"\") | string | replace(\"-\", \"\") | replace(\":\", \"\") | replace(\" \", \"\") -%}\n<div class=\"mr\">\n  <div class=\"hdr\">KENTROUT FARM</div>\n  <div class=\"sub\">Meal Receipt</div>\n  <hr>\n  <div class=\"meal\">{{ (doc.log_type or \"\") | upper }}</div>\n  <table>\n    <tr><td class=\"k\">Employee</td><td class=\"v\">{{ emp }}</td></tr>\n    <tr><td class=\"k\">Payroll No</td><td class=\"v\">{{ payroll }}</td></tr>\n    <tr><td class=\"k\">Time</td><td class=\"v\">{{ doc.get_formatted(\"time\") }}</td></tr>\n  </table>\n  <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=150x150&margin=0&data=KENTROUT_{{ doc.name }}_{{ payroll }}_{{ doc.log_type }}_{{ tqr }}\" width=\"128\" height=\"128\">\n  <hr>\n  <div class=\"foot\">Receipt {{ doc.name }}</div>\n</div>\n",
